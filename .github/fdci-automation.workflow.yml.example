# LOCAL PREPARATION ONLY. Outside workflows/; GitHub cannot run this file.
# Resolve the reviewed action SHAs and CPU reader before publication approval.
name: FDCI automation (disabled preparation)
on:
  workflow_dispatch:
  # schedule: [{ cron: '17 */2 * * *' }]
permissions:
  contents: read
  actions: read
concurrency:
  group: fdci-import
  cancel-in-progress: false
jobs:
  import:
    if: >-
      github.repository == 'possee41/docentetuc' &&
      vars.FDCI_AUTOMATION_ENABLED == 'true' &&
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    environment: fdci-automation
    runs-on: ubuntu-latest
    timeout-minutes: 7
    steps:
      - uses: actions/checkout@REQUIRES_REVIEWED_FULL_SHA
        with:
          ref: ${{ vars.FDCI_AUTOMATION_APPROVED_SHA }}
          persist-credentials: false
      - uses: actions/setup-node@REQUIRES_REVIEWED_FULL_SHA
        with:
          node-version: '24'
      - name: Fail closed after previous failure, including a D1 preflight outage
        env:
          GITHUB_TOKEN: ${{ github.token }}
          FDCI_AUTOMATION_APPROVED_SHA: ${{ vars.FDCI_AUTOMATION_APPROVED_SHA }}
          FDCI_AUTOMATION_BOOTSTRAP_SHA: ${{ vars.FDCI_AUTOMATION_BOOTSTRAP_SHA }}
          FDCI_AUTOMATION_RECOVERY_RUN_ID: ${{ vars.FDCI_AUTOMATION_RECOVERY_RUN_ID }}
        run: node scripts/fdci-automation-history.mjs
      - name: One bounded run; no retries
        timeout-minutes: 5
        env:
          SYNC_SOURCE: fdci
          FDCI_AUTOMATION_ENABLED: 'true'
          IMPORT_GATEWAY_ENABLED: 'true'
          IMPORT_GATEWAY_TARGET: production
          IMPORT_GATEWAY_PRODUCTION_ENABLED: 'true'
          IMPORT_GATEWAY_APPROVED_SHA: ${{ vars.FDCI_AUTOMATION_APPROVED_SHA }}
          IMPORT_GATEWAY_ORIGIN: ${{ vars.IMPORT_GATEWAY_ORIGIN }}
          IMPORT_GATEWAY_DATABASE_ID: ${{ vars.IMPORT_GATEWAY_DATABASE_ID }}
          IMPORT_GATEWAY_DATABASE_NAME: ${{ vars.IMPORT_GATEWAY_DATABASE_NAME }}
          IMPORT_GATE_RUN_ID: ${{ github.run_id }}-${{ github.run_attempt }}
          IMPORT_GATE_TTL_SECONDS: '600'
          FDCI_AUTOMATION_SECRET: ${{ secrets.FDCI_AUTOMATION_SECRET }}
          FDCI_SCOPE: active
          FDCI_MAX_PUBLICATIONS: '2'
          FDCI_MAX_REQUESTS: '6'
          FDCI_PAUSE_MS: '400'
        run: |
          set -o pipefail
          node scripts/fdci-automation.mjs | tee fdci-automation-result.json
      - name: Safe result summary
        if: always()
        run: |
          node --input-type=module <<'NODE' >> "$GITHUB_STEP_SUMMARY"
          import {readFileSync} from 'node:fs';
          let r = {};
          try { r = JSON.parse(readFileSync('fdci-automation-result.json','utf8')); } catch {}
          const allowed = ['CHANGES','NO_CHANGES','NO_ACTIVE_DATA','PARTIAL_PROGRESS','FAILED'];
          console.log('FDCI: ' + (allowed.includes(r.outcome) ? r.outcome : 'NO_RESULT'));
          console.log('Status: ' + (['OK','PARTIAL','ERROR'].includes(r.status) ? r.status : 'NO_RESULT'));
          if (/^[A-Z_0-9]+$/.test(r.code || '')) console.log('Code: ' + r.code);
          console.log('Suspended: ' + (r.automationSuspended === true));
          for (const key of ['examined','created','updated','unchanged','rejected','sourceRequests'])
            console.log(key + ': ' + (Number.isSafeInteger(r[key]) ? r[key] : 'unavailable'));
          NODE
