{
  "name": "docentetuc-web-juntas-canary-1-2",
  "main": "dist/server/public-snapshot-canary-entry.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "triggers": { "crons": [] },
  "vars": {
    "PUBLIC_SNAPSHOT_ENABLED": "true",
    "PUBLIC_SNAPSHOT_CANARY_ENABLED": "false",
    "PUBLIC_SNAPSHOT_CANARY_UNTIL": "",
    "PUBLIC_SNAPSHOT_CANARY_MAX_GETS": "2",
    "PUBLIC_APP_CACHE_ENABLED": "1",
    "JUNTAS_CANARY_DATABASE_ID": "0979f2c2-0e96-4b5c-811b-adcccc2dbd6d",
    "LEGACY_SYNC_PAUSED": "true",
    "PUSH_DISPATCH_MODE": "disabled",
    "FDCI_AUTOMATION_ENABLED": "false",
    "FDCI_EXTERNAL_ENABLED": "false"
  },
  "durable_objects": { "bindings": [{ "name": "PUBLIC_SNAPSHOT", "class_name": "PublicSnapshot" }] },
  "migrations": [{ "tag": "public-snapshot-canary-v1", "new_sqlite_classes": ["PublicSnapshot"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "docentetuc-sources-canary-1-2",
    "database_id": "0979f2c2-0e96-4b5c-811b-adcccc2dbd6d"
  }],
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": {
    "enabled": true, "invocation_logs": true, "head_sampling_rate": 1, "persist": true
  }, "traces": { "enabled": true, "head_sampling_rate": 1 } }
}
