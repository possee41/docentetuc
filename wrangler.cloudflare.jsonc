{
  "name": "docentetuc",
  "main": "dist/server/worker-entry.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AI_PROVIDER": "gemini",
    "AI_MODEL": "gemini-3.5-flash-lite",
    "FDCI_SYNC_MODE": "legacy"
  },
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": { "directory": "dist/client" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "docentetuc-db",
    "database_id": "baaf5886-0123-4948-96da-aa7106424549"
  }]
}
