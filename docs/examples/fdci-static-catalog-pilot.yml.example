# INACTIVE TEMPLATE. Not under .github/workflows. No schedule, Pages or Cloudflare permissions.
name: FDCI static state synthetic pilot
on:
  workflow_dispatch:
    inputs:
      bootstrap:
        description: Explicitly authorize an empty initial state
        type: boolean
        default: false
permissions:
  contents: read
  actions: read
concurrency:
  group: fdci-static-state-v1
  cancel-in-progress: false
jobs:
  synthetic:
    if: github.repository == 'possee41/docentetuc' && vars.FDCI_STATIC_PILOT_ENABLED == 'true'
    runs-on: ubuntu-latest
    environment: fdci-static-pilot
    timeout-minutes: 8
    env:
      GH_TOKEN: ${{ github.token }}
      FDCI_STATIC_APPROVED_SHA: ${{ vars.FDCI_STATIC_APPROVED_SHA }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
      - name: Verify reviewed code
        run: |
          [[ "$FDCI_STATIC_APPROVED_SHA" =~ ^[a-f0-9]{40}$ ]]
          test "$(git rev-parse HEAD)" = "$FDCI_STATIC_APPROVED_SHA"
      - name: Select previously committed artifact state
        id: state
        env:
          BOOTSTRAP: ${{ inputs.bootstrap }}
        run: |
          set -euo pipefail
          export FDCI_STATIC_WORKFLOW_ID="$(gh api "repos/$GITHUB_REPOSITORY/actions/workflows/fdci-static-catalog-pilot.yml" --jq .id)"
          gh api "repos/$GITHUB_REPOSITORY/actions/workflows/$FDCI_STATIC_WORKFLOW_ID/runs?per_page=50" --jq '.workflow_runs' > runs.json
          gh api "repos/$GITHUB_REPOSITORY/actions/artifacts?name=fdci-static-state-v1&per_page=100" --jq '.artifacts' > artifacts.json
          RUN="$(node scripts/fdci-static-artifact.mjs select artifacts.json runs.json)"
          if [[ -n "$RUN" ]]; then
            gh run download "$RUN" --repo "$GITHUB_REPOSITORY" --name fdci-static-state-v1 --dir restored
            node scripts/fdci-static-artifact.mjs restore restored/state.json .fdci-runner
          else
            test "$BOOTSTRAP" = true # No silent empty reset when state is lost/expired.
          fi
      - name: Synthetic collection only
        run: node scripts/fdci-static-artifact.mjs synthetic-cycle .fdci-runner
      - name: Export confirmed progress and last complete public snapshot
        id: export
        if: always()
        run: node scripts/fdci-static-artifact.mjs export .fdci-runner artifact/state.json
      - uses: actions/upload-artifact@v4
        if: always() && steps.export.outcome == 'success'
        with:
          name: fdci-static-state-v1
          path: artifact/state.json
          if-no-files-found: error
          retention-days: 2
